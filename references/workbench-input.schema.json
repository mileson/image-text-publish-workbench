{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "图文发布工作台输入",
  "type": "object",
  "required": [
    "schema_version",
    "document_id",
    "topic",
    "titles",
    "body_variants"
  ],
  "properties": {
    "schema_version": {
      "const": "image-text-publish-workbench.input.v1"
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "titles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/variant"
      }
    },
    "body_variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/variant"
      }
    },
    "selected_title_id": {
      "type": "string"
    },
    "selected_body_id": {
      "type": "string"
    },
    "selected_cover_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "selected",
          "reason"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[^#\\s]+$"
          },
          "selected": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "covers": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/asset"
          },
          {
            "properties": {
              "role": {
                "const": "cover"
              }
            }
          }
        ]
      }
    },
    "photos": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/asset"
          },
          {
            "properties": {
              "role": {
                "const": "photo"
              }
            }
          }
        ]
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "title": {
          "type": "integer",
          "minimum": 1
        },
        "body": {
          "type": "integer",
          "minimum": 1
        },
        "tags": {
          "type": "integer",
          "minimum": 1
        },
        "max_upload_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 209715200
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "variant": {
      "type": "object",
      "required": [
        "id",
        "label",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": [
        "id",
        "label",
        "path",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "role": {
          "enum": [
            "cover",
            "photo"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "fileName": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "mime": {
          "enum": [
            "image/jpeg",
            "image/png",
            "image/webp"
          ]
        },
        "source": {
          "const": "registered"
        },
        "publishable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
